# Copy this file to .env and adjust as needed

# Local server binding; use 0.0.0.0 only when LAN access is required
APP_HOST=127.0.0.1
APP_PORT=8000

# Optional HTTPS. Use a trusted certificate whose SAN includes the host used
# by clients. Paths are relative to backend/ unless absolute. Never expose the
# private key. Leave both empty for localhost-only HTTP development.
TLS_CERTFILE=
TLS_KEYFILE=
# Set true only when a trusted hosting proxy terminates HTTPS before the app.
# The public backend URL and the connection from Vercel to it must still use HTTPS.
TLS_TERMINATED_BY_PROXY=false

# Vite development server; bind to loopback unless HTTPS is configured above.
# VITE_* values are public, never put secrets here.
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Directories
MODELS_DIR=models
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# Upload limits
MAX_MODEL_SIZE_MB=2048
MAX_IMAGE_SIZE_MB=100

# Inference defaults
DEFAULT_TILE_SIZE=128
DEFAULT_TILE_OVERLAP=16
DEFAULT_BATCH_SIZE=1
DEFAULT_DEVICE=auto
DEFAULT_PROCESSING_MODE=tile

# CORS
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Authentication and session security
SESSION_COOKIE_NAME=model_session
SESSION_TTL_SECONDS=604800
# Set true whenever HTTPS is enabled (or TLS terminates at a trusted proxy).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
MIN_PASSWORD_LENGTH=10
MAX_PASSWORD_LENGTH=128
# Keep false for private deployments; set true to allow user self-registration.
ALLOW_PUBLIC_REGISTRATION=false
# Required for first-time administrator creation; use a random secret of at least 32 characters.
# INITIAL_ADMIN_SETUP_KEY=
# Optional. Set a random key with at least 32 characters to enable password recovery.
# Keep this value private; it can reset any account.
# ACCOUNT_RECOVERY_KEY=

# MySQL authentication database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=model_app
MYSQL_PASSWORD=replace-with-your-local-database-password
MYSQL_DATABASE=model_restoration
# Required when MYSQL_HOST is not localhost/loopback. Must be the CA that
# signed the MySQL server certificate; hostname verification is enabled.
# MYSQL_SSL_CA=certs/mysql-ca.pem
